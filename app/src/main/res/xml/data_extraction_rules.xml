<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer rules. The database holds raw bank SMS text, so nothing is
  copied to cloud backup or to a new phone. Users move data with the CSV/Excel export instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
